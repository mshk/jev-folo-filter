{
  "name": "jev-folo-filter",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.9.0"
  },
  "scripts": {
    "login": "folo login",
    "fetch": "node --env-file-if-exists=.env src/cli.js fetch",
    "filter": "node --env-file-if-exists=.env src/cli.js filter",
    "scores": "node src/cli.js scores",
    "start": "node --env-file-if-exists=.env src/cli.js run",
    "test": "node --test"
  },
  "overrides": {
    "better-auth": "1.6.22",
    "drizzle-orm": "0.45.2",
    "nanoid": "5.1.16"
  },
  "dependencies": {
    "@typesafe-ai/sdk": "0.6.0",
    "folocli": "0.0.5",
    "html-to-text": "9.0.5"
  },
  "description": "Fetch Folo subscriptions and curate articles with Jev structured evaluations.",
  "license": "MIT",
  "author": "mshk",
  "repository": {
    "type": "git",
    "url": "https://github.com/mshk/jev-folo-filter.git"
  },
  "homepage": "https://github.com/mshk/jev-folo-filter"
}
